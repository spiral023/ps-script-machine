{
    "$schema": "https://json-schema.org/draft-07/schema",
    "description": "Example settings for ps-script-machine. Copy to settings.json and replace with your values. NEVER commit the real settings file.",
    "module": {
        "name": "ps-script-machine",
        "version": "1.0.0"
    },
    "logging": {
        "enabled": true,
        "level": "Information",
        "logFile": "",
        "console": true
    },
    "export": {
        "defaultPath": "C:\\Exports",
        "defaultFormats": ["CSV", "JSON"]
    },
    "vcenter": {
        "defaultServer": "",
        "port": 443,
        "protocol": "https",
        "timeout": 300
    },
    "security": {
        "useSecretManagement": true,
        "vaultName": "MyVault",
        "secretNamePrefix": "vcenter-"
    },
    "testing": {
        "unitTests": true,
        "integrationTests": false,
        "codeCoverageThreshold": 80
    }
}